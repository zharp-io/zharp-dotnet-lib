<Project Sdk="Microsoft.NET.Sdk">
  <!-- A .NET MAUI app set up the way `npm init zharp` does it: Zharp.Maui, and Zharp.Build so
       release stacks get their lines. The e2e workflows build one platform per runner:
       -f net10.0-android | net10.0-ios | net10.0-maccatalyst | net10.0-windows10.0.19041.0 -->
  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
    <!-- One platform per runner (restore looks at every target framework): -p:ShopTargets=net10.0-android -->
    <TargetFrameworks Condition="'$(ShopTargets)' != ''">$(ShopTargets)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>Shop.Mobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ApplicationTitle>Shop</ApplicationTitle>
    <ApplicationId>io.zharp.e2e.shop</ApplicationId>
    <ApplicationDisplayVersion>1.4.0</ApplicationDisplayVersion>
    <ApplicationVersion>212</ApplicationVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- CI: no signing identity; the simulator and an ad-hoc signed Mac Catalyst app need none. -->
    <EnableCodeSigning Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">false</EnableCodeSigning>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Zharp.Maui" Version="$(ZharpVersion)" />
    <PackageReference Include="Zharp.Build" Version="$(ZharpVersion)" PrivateAssets="all" />
  </ItemGroup>
</Project>
