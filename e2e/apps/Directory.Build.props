<Project>
  <!-- The e2e apps are ordinary apps: no settings from the SDK's own build. -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AppTfm Condition="'$(AppTfm)' == ''">net10.0</AppTfm>
    <ZharpVersion Condition="'$(ZharpVersion)' == ''">0.2.0</ZharpVersion>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <!-- The code that ran: sources inside the PDB (what `npm init zharp` turns on). -->
    <EmbedAllSources Condition="'$(EmbedAllSources)' == ''">true</EmbedAllSources>
  </PropertyGroup>
</Project>
