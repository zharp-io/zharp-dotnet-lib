<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>$(AppTfm)</TargetFramework>
    <EfVersion Condition="'$(AppTfm)' == 'net8.0'">8.0.34</EfVersion>
    <NpgsqlEfVersion Condition="'$(AppTfm)' == 'net8.0'">8.0.11</NpgsqlEfVersion>
    <EfVersion Condition="'$(AppTfm)' == 'net10.0'">10.0.15</EfVersion>
    <NpgsqlEfVersion Condition="'$(AppTfm)' == 'net10.0'">10.0.4</NpgsqlEfVersion>
    <EfVersion Condition="'$(AppTfm)' == 'net11.0'">11.0.0</EfVersion>
    <NpgsqlEfVersion Condition="'$(AppTfm)' == 'net11.0'">11.0.0</NpgsqlEfVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Zharp.AspNetCore" Version="$(ZharpVersion)" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="$(NpgsqlEfVersion)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="$(EfVersion)" />
  </ItemGroup>
</Project>
