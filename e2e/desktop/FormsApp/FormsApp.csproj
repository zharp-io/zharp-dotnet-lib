<Project Sdk="Microsoft.NET.Sdk">
  <!-- A Windows Forms app, on .NET 10 and on .NET Framework 4.8, set up the way `npm init zharp` does it. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net10.0-windows;net48</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Shop.Desktop</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <DebugType>portable</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Zharp.Windows" Version="$(ZharpVersion)" />
    <PackageReference Include="Zharp.Build" Version="$(ZharpVersion)" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
