<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- ZHARP_KEY and ZHARP_ENDPOINT come from the environment in the workflow. -->
    <add key="Zharp:Service" value="aspnet-classic-e2e" />
    <add key="Zharp:Logs" value="true" />
  </appSettings>
  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <customErrors mode="Off" />
  </system.web>
  <system.webServer>
    <modules runAllManagedModulesForAllRequests="true" />
  </system.webServer>
</configuration>
