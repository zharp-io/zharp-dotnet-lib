<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '11.0'))">$(TargetFrameworks);net11.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT'">$(TargetFrameworks);net48</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- The tests read their own sources back from the PDB, as the SDK does in production. -->
    <EmbedAllSources>true</EmbedAllSources>
    <DebugType>portable</DebugType>
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <ProjectReference Include="..\..\src\Zharp\Zharp.csproj" />
    <ProjectReference Include="..\..\src\Zharp.Build\Zharp.Build.csproj" />
    <ProjectReference Include="..\NoPdbSample\NoPdbSample.csproj" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" />
  </ItemGroup>
  <!-- The sample ships as apps do, without its PDB; the PDB is kept aside for the tests that read it. -->
  <Target Name="ZharpTestsMoveSamplePdb" AfterTargets="Build">
    <Copy SourceFiles="$(OutDir)NoPdbSample.pdb" DestinationFolder="$(OutDir)symbols" Condition="Exists('$(OutDir)NoPdbSample.pdb')" />
    <Delete Files="$(OutDir)NoPdbSample.pdb" />
  </Target>
  <ItemGroup Condition="'$(TargetFramework)' != 'net48'">
    <ProjectReference Include="..\..\src\Zharp.AspNetCore\Zharp.AspNetCore.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="all" />
  </ItemGroup>
</Project>
